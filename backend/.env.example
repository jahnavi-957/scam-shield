# =====================================================================
# Local development configuration.
#
# On EC2 these values come from AWS SSM Parameter Store instead
# (SSM_ENABLED=true) — secrets never live in a file on the
# instance. Only NON-secret config may be committed here.
# =====================================================================

# --- Database (compose exposes Postgres on 127.0.0.1:5433) ---
DATABASE_URL=postgresql+psycopg://scamshield:scamshield_dev@localhost:5433/scamshield

# --- AWS ---
AWS_REGION=us-east-1
# Flip to true on EC2 to overlay the values below from SSM.
SSM_ENABLED=false
# SSM parameter path: <prefix>/<environment>/<name>
SSM_PREFIX=/scam-shield

# --- S3 / SNS (empty locally -> presigned URLs and alerts no-op) ---
S3_BUCKET=
SNS_TOPIC_ARN=

# --- Alert rule: fire when an entity reaches N reports within M minutes ---
ALERT_THRESHOLD=5
ALERT_WINDOW_MINUTES=1440

# --- Presigned upload URL lifetime (seconds) ---
PRESIGN_EXPIRY_SECONDS=900

# --- OCR engine: tesseract (local binary) | textract (AWS) ---
OCR_ENGINE=tesseract

# --- Model weights: pulled from S3 at startup when a bucket is set ---
MODEL_S3_BUCKET=
MODEL_S3_KEY=scam-shield/model/
MODEL_DIR=/var/lib/scamshield/model

# --- Input limits ---
MAX_TEXT_LENGTH=10000
MAX_PAYLOAD_BYTES=2097152

# --- Frontend origins allowed by CORS ---
CORS_ORIGINS=http://localhost:5173

# --- Environment label (local | dev | prod); selects the SSM path ---
ENVIRONMENT=local
