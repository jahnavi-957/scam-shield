# Canonical local Compose configuration. Copy once:
#   cp .env.example .env
# Never use these development-only values in AWS.

POSTGRES_USER=scamshield
POSTGRES_PASSWORD=scamshield_dev
POSTGRES_DB=scamshield
DATABASE_URL=postgresql+psycopg://scamshield:scamshield_dev@db:5432/scamshield

ENVIRONMENT=local
SSM_ENABLED=false
AWS_REGION=us-east-1

# Browser-facing API and S3-compatible upload endpoints.
VITE_API_URL=http://localhost:8000
S3_BUCKET=scamshield-local
S3_ENDPOINT_URL=http://s3mock:4566
S3_PUBLIC_ENDPOINT_URL=http://localhost:4566
S3_FORCE_PATH_STYLE=true

# LocalStack test credentials
AWS_ACCESS_KEY_ID=test
AWS_SECRET_ACCESS_KEY=test

# Keep alert behavior testable without AWS SNS.
SNS_TOPIC_ARN=
SNS_MOCK_ENABLED=true
ALERT_THRESHOLD=5
ALERT_WINDOW_MINUTES=1440

PRESIGN_EXPIRY_SECONDS=300
OCR_ENGINE=tesseract
MAX_TEXT_LENGTH=10000
MAX_PAYLOAD_BYTES=2097152
MAX_IMAGE_BYTES=10485760
MAX_IMAGE_WIDTH=4096
MAX_IMAGE_HEIGHT=4096
MAX_IMAGE_PIXELS=16777216
ANALYSIS_RATE_LIMIT_PER_MINUTE=20
ANALYSIS_RATE_LIMIT_WINDOW_SECONDS=60

CORS_ORIGINS=http://localhost:5173,http://127.0.0.1:5173,http://localhost:8000,http://127.0.0.1:8000
CORS_METHODS=GET,POST,PUT,DELETE,OPTIONS,HEAD
CORS_HEADERS=Accept,Content-Type,Origin,X-Requested-With,Cache-Control,Pragma,Authorization
SECURITY_HEADERS_ENABLED=true
HSTS_ENABLED=false
